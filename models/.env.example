# CareScribe model service — environment variables.
# Copy to .env and adjust. Every value has a working default, so an empty file
# still boots the service.

# --- service --------------------------------------------------------------
HOST=0.0.0.0
PORT=9000
SERVICE_VERSION=0.1.0

# --- capability switches --------------------------------------------------
# false  -> every heavy backend is skipped and each endpoint serves its
#           documented fallback immediately. Use for CI, and for demos on a
#           machine that must not download weights mid-presentation.
# true   -> heavy backends are attempted (lazily, on first use).
ENABLE_HEAVY_MODELS=true

# true  -> resolve models at startup on a background thread.
# false -> resolve on first request. Tests use false for determinism.
WARMUP_ON_STARTUP=true

# --- compute --------------------------------------------------------------
# auto | cpu | cuda | mps. 'auto' prefers CUDA, then Apple MPS, then CPU.
# CPU is always supported; GPU only ever accelerates (rule 6).
DEVICE=auto

# --- paths ----------------------------------------------------------------
WEIGHTS_DIR=weights
LOGS_DIR=logs
REPORTS_DIR=reports
# SQLite file behind scripts/inference_report.py. Holds timings, sizes and
# confidences only — never patient data.
INFERENCE_DB=logs/inference.db

# --- thresholds -----------------------------------------------------------
# Face liveness score required to pass. The liveness check is a texture
# heuristic, not a certified PAD model; see services/faceid_service.py.
LIVENESS_THRESHOLD=0.5

# Batch cap for POST /embed. Larger calls are rejected with batch_too_large.
MAX_EMBED_BATCH=100

# Images with a side shorter than this are rejected before any model runs.
MIN_IMAGE_SIDE=32

# --- model selection ------------------------------------------------------
# Whisper checkpoint. Swap for a Hindi or larger model, e.g.
#   vasista22/whisper-hindi-large-v2
WHISPER_MODEL=openai/whisper-base
