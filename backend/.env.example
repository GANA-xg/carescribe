# CareScribe backend environment — documented for OC-15.
# Copy to .env and fill in. NEVER commit real secrets.

# --- Core ---
# Database (asyncpg dialect required). Dev default hits the compose postgres.
DATABASE_URL=postgresql+asyncpg://carescribe:carescribe@localhost:5432/carescribe

# Auth — REQUIRED in production (backend refuses to boot on the default).
# Generate: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me

# Face embedding encryption — REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- RAG assistant LLM (optional) ---
# Without a key, the assistant replies records-only (never invents).
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Integrations ---
# Internal model service (FreeBuff). Default hits localhost for bare-metal
# dev; compose overrides to http://models:9000.
MODEL_SERVICE_URL=http://localhost:9000

# OpenEMR FHIR (register an OAuth client in OpenEMR admin first).
OPENEMR_BASE_URL=http://localhost:8300/apis/default/fhir
OPENEMR_TOKEN_URL=http://localhost:8300/apis/default/token
OPENEMR_CLIENT_ID=carescribe-backend
OPENEMR_CLIENT_SECRET=

# Orthanc DICOM server.
ORTHANC_URL=http://localhost:8042

# Redis (OCR job store).
REDIS_URL=redis://localhost:6379/0

# --- Security (OC-14) ---
# Comma-separated allowed origins.
CORS_ORIGINS=http://localhost:3000

# Rate limiting: on | off (off for CI/tests only).
RATE_LIMITS=on

# development | production. prod + default JWT_SECRET = refuse to boot.
ENVIRONMENT=development
